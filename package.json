{
  "name": "course",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "build:watch": "ng build --watch",
    "build:stats": "ng build --configuration production --stats-json",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "dev:ssr": "ng serve",
    "build:ssr": "ng build --configuration production",
    "build:ssr:fast": "NODE_OPTIONS='--max-old-space-size=4096' ng build --configuration production --progress=false",
    "build:ssr:analyze": "ng build --configuration production --stats-json && npx source-map-explorer dist/Course/browser/*.js",
    "build:server": "ng run Course:server:production",
    "build:server:analyze": "ng run Course:server:production && npx source-map-explorer dist/Course/server/*.js",
    "build:prerender": "ng build --configuration production",
    "serve:ssr": "node dist/Course/server/server.mjs",
    "analyze:bundle": "pnpm run build:stats && source-map-explorer dist/Course/browser/*.js",
    "analyze:server": "source-map-explorer dist/Course/server/*.js",
    "verify:seo": "ts-node scripts/verify-ssr-seo.ts",
    "verify:seo:js": "node scripts/verify-ssr-seo.js",
    "check:stability": "ts-node scripts/check-ssr-stability.ts",
    "monitor:dashboard": "node scripts/monitoring-dashboard.js",
    "docker:test:build": "docker build -t course-frontend-test .",
    "docker:test:run": "docker run -d --name course-frontend-test --restart unless-stopped -p 4008:4000 course-frontend-test",
    "docker:test:remove": "docker rm -f course-frontend-test || true",
    "docker:test:deploy": "npm run docker:test:build && npm run docker:test:remove && npm run docker:test:run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.1.6",
    "@angular/common": "20.1.6",
    "@angular/compiler": "20.1.6",
    "@angular/core": "20.1.6",
    "@angular/forms": "20.1.6",
    "@angular/localize": "20.1.6",
    "@angular/platform-browser": "20.1.6",
    "@angular/platform-browser-dynamic": "20.1.6",
    "@angular/platform-server": "20.1.6",
    "@angular/router": "20.1.6",
    "@angular/ssr": "20.1.5",
    "@ng-bootstrap/ng-bootstrap": "^13.1.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^4.6.2",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mock-browser": "^0.92.14",
    "ng-multiselect-dropdown": "^1.0.0",
    "ng2-search-filter": "^0.5.1",
    "ngx-filter-pipe": "^3.0.1",
    "ngx-owl-carousel-o": "^20.0.1",
    "ngx-pagination": "^6.0.2",
    "ngx-spinner": "^12.0.0",
    "node-cache": "^5.1.2",
    "redis": "^5.9.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.1.5",
    "@angular/build": "20.1.5",
    "@angular/cli": "20.1.5",
    "@angular/compiler-cli": "20.1.6",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^20.19.10",
    "browser-sync": "^3.0.0",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "webpack": "^5.0.0"
  },
  "packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa",
  "sideEffects": [
    "src/polyfills.ts",
    "src/styles.scss",
    "**/*.scss",
    "**/*.css"
  ]
}
