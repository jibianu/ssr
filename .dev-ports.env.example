# Development Port Configuration
# Copy this file to .dev-ports.env and modify as needed
# This file is for reference - actual ports are configured in angular.json, proxy.conf.json, and src/server.ts

# Frontend Angular Dev Server Port (default: 4200)
FRONTEND_PORT=4200

# Backend .NET Core API Port (default: 52045)
BACKEND_PORT=52045

# SSR Server Port (default: 4000)
SSR_PORT=4000

# Backend URL (used by proxy and SSR)
BACKEND_URL=https://localhost:52045
