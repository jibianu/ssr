# ✅ Angular SSR - Nginx Configuration for Deep Link Support
# This configuration ensures deep links work correctly without 404 errors
# Place this in your server's nginx configuration directory

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;
    
    # Root directory for Angular app
    root /path/to/your/app/dist/Course/browser;
    index index.html;
    
    # ✅ FIX: Serve static files directly
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ✅ FIX: Try to serve the file, then directory, then fallback to index.html
    # This ensures deep links work correctly
    location / {
        try_files $uri $uri/ /index.html;
        
        # ✅ SSR: Proxy to Node.js SSR server for server-side rendering
        # Uncomment these lines if you're using SSR in production
        # proxy_pass http://localhost:4000;
        # proxy_http_version 1.1;
        # proxy_set_header Upgrade $http_upgrade;
        # proxy_set_header Connection 'upgrade';
        # proxy_set_header Host $host;
        # proxy_cache_bypass $http_upgrade;
    }
    
    # ✅ Alternative: If NOT using SSR, use this simpler configuration
    # This rewrites all routes to index.html for client-side routing
    # location / {
    #     try_files $uri $uri/ /index.html;
    # }
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
}

# ✅ HTTPS Configuration (recommended for production)
